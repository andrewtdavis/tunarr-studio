# Tunarr Studio — nginx front that serves the UI and proxies the API to Tunarr.
# Serving the page and the API from the SAME origin removes the browser CORS
# problem entirely: the UI just calls /api/... and nginx forwards it to Tunarr.

server {
    listen 80;
    server_name _;

    # Static UI
    root /usr/share/nginx/html;
    index tunarr-studio.html;

    # Default to the studio page
    location = / {
        try_files /tunarr-studio.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Proxy everything under /api to the real Tunarr server.
    # Set TUNARR_HOST / TUNARR_PORT in the compose file.
    location /api/ {
        proxy_pass http://tunarr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Streaming-friendly: don't buffer long responses
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Upstream is templated in via the compose entrypoint (envsubst), so you only
# set the address once in docker-compose.yml.
upstream tunarr_upstream {
    server ${TUNARR_HOST}:${TUNARR_PORT};
}
